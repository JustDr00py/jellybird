# Real-Debrid API token (https://real-debrid.com/apitoken) — or leave empty
# if you only use TorBox.
JELLYBIRD_REALDEBRID_API_KEY=

# TorBox API key (TorBox → Settings → API) — optional if using Real-Debrid.
JELLYBIRD_TORBOX_API_KEY=

# Free TMDB v3 key for the search UI (https://www.themoviedb.org/settings/api)
JELLYBIRD_TMDB_API_KEY=

# Optional Jellyseerr watchlist automation
JELLYBIRD_JELLYSEERR_URL=
JELLYBIRD_JELLYSEERR_API_KEY=

# Shared secret protecting /stream (.strm links) and API access for the
# Jellybird Jellyfin plugin (X-Jellybird-Token header). Strongly recommended;
# when set it's also required to claim the first dashboard account at /setup.
JELLYBIRD_SERVER_TOKEN=

# Dashboard login. Leave empty and visit /setup on first run, or set both to
# create the account at startup (also resets a forgotten password).
JELLYBIRD_ADMIN_USERNAME=
JELLYBIRD_ADMIN_PASSWORD=

# Base URL written into .strm files. Must be reachable from your TVs/phones,
# not only from Jellyfin: use this host's LAN address or DNS name. The default
# (http://jellybird:8097) only resolves inside the compose network, which
# breaks direct play on Roku and Android TV / Google TV.
JELLYBIRD_SERVER_EXTERNAL_URL=http://192.168.1.50:8097
